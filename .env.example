# Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: pin the pipeline to ONE model id. Leave commented out to use the full
# fallback chain (gemini-3.6-flash -> gemini-3.5-flash -> gemma-4-31b-it).
# GEMINI_MODEL=gemini-3.6-flash

# Optional quality/tuning knobs
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
GEMINI_THINKING_LEVEL=HIGH
GEMINI_MAX_ATTEMPTS=3
